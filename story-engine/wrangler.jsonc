// Cloudflare Workers Builds deploys this folder with `npx wrangler deploy`.
// Front door only — no static assets, so operator pages in public/ are never
// published without the stateful runtime behind them. STORYENGINE_RUNTIME_ORIGIN
// points at the Railway runtime; config/domain-authority.json separately owns the
// public canonical StoryEngine origin. Preview bindings remain isolated and fail
// closed because production vars are not inherited.
{
  "name": "storyengine",
  "main": "./cloudflare-frontdoor/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "STORYENGINE_RUNTIME_ORIGIN": "https://story-engine-production-1e6b.up.railway.app"
  },
  "ratelimits": [
    {
      "name": "STORYENGINE_API_RATE_LIMITER",
      "namespace_id": "1292370402",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "previews": {
    "ratelimits": [
      {
        "name": "STORYENGINE_API_RATE_LIMITER",
        "namespace_id": "2026102701",
        "simple": {
          "limit": 120,
          "period": 60
        }
      }
    ]
  }
}
