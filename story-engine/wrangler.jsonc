{
  "name": "storyengine",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "containers": [
    {
      "class_name": "StoryEngineContainer",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STORYENGINE_CONTAINER",
        "class_name": "StoryEngineContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "storyengine-container-v1-20260829",
      "new_sqlite_classes": ["StoryEngineContainer"]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
