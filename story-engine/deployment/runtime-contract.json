{
  "schemaVersion": 2,
  "service": "l99-story-engine",
  "runtime": {
    "kind": "stateful-container",
    "nodeMajor": 24,
    "portEnvironmentVariable": "PORT"
  },
  "state": {
    "backend": "sqlite",
    "databaseEnvironmentVariable": "L99_DB_PATH",
    "persistentMountRequired": true,
    "ephemeralContainerDiskAccepted": false,
    "recommendedMountPath": "/data",
    "recommendedDatabasePath": "/data/l99.db",
    "durabilityRequirement": "database file survives container restart and reschedule"
  },
  "releaseIdentity": {
    "environmentVariable": "L99_RELEASE_SHA",
    "format": "git-sha-1",
    "healthPath": "/healthz",
    "identityPath": "/runtime-identity"
  },
  "secrets": {
    "required": [
      "L99_API_KEYS_JSON"
    ],
    "mustNotBeCommitted": true
  },
  "providerCompatibility": {
    "requiredCapabilities": [
      "container-process",
      "durable-mounted-filesystem",
      "sqlite-file-persistence",
      "exact-release-identity",
      "https-origin"
    ],
    "failClosedOnUnknownTarget": true,
    "providerCheckAuthoritativeOnlyWhenCompatible": true
  },
  "promotion": {
    "productionOriginSource": "config/domain-authority.json",
    "requiresProductionPlaywright": true,
    "requiresExactReleaseIdentity": true,
    "requiresPersistentState": true,
    "requiresProviderAuthority": true
  }
}
