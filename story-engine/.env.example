# Required before serving L99 outside localhost.
# Use a scoped registry so each credential carries an actor, tenant, role, and
# workspace boundary. Generate long random key values and keep them out of git.
L99_API_KEYS_JSON=[{"key":"replace-with-a-long-random-secret","actor_id":"founder","tenant_id":"founder","role":"administrator","workspace_ids":["*"]}]

# Production runtime truth. L99_DB_PATH must point at durable mounted storage.
# Railway GitHub deployments inject RAILWAY_GIT_COMMIT_SHA automatically and
# StoryEngine uses that provider-native SHA as production release truth.
# L99_RELEASE_SHA is only a fallback for non-Railway/manual container runs.
L99_DB_PATH=/data/l99.db
L99_RELEASE_SHA=

# LLM provider configuration. Keep real keys in the provider secret store only.
# Story drafting defaults to Anthropic. ANTHROPIC_WORKSPACE_ID is required only
# for multi-workspace/identity-linked keys; omit it for a workspace-scoped key.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEEP_MODEL=claude-opus-5
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_ERROR_BODY_MAX_BYTES=4096

# Legacy compatibility only. Production ignores API_KEY unless this escape hatch
# is explicitly set to true. Leave both values disabled for new deployments.
API_KEY=
ALLOW_LEGACY_API_KEY=false

# Maximum JSON request body accepted by the main API router.
# Default: 10 MiB. The standalone manuscript audit should use its own bounded route.
API_MAX_BODY_BYTES=10485760

# Optional runtime scheduler controls.
RUNTIME_SCAN_INTERVAL_MS=300000
RUNTIME_DRAIN_INTERVAL_MS=15000
