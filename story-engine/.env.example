# Required before serving L99 outside localhost.
# Use a scoped registry so each credential carries an actor, tenant, role,
# principal type, and workspace boundary. Human canon authority requires an
# explicitly classified `human` principal that has established a server session.
# Missing/unknown principal_type fails closed for human-only decisions.
# Generate long random key values and keep them out of git.
L99_API_KEYS_JSON=[{"key":"replace-with-a-long-random-secret","actor_id":"founder","tenant_id":"founder","role":"administrator","principal_type":"human","workspace_ids":["*"]}]

# Production runtime truth. L99_DB_PATH must point at durable mounted storage,
# and L99_RELEASE_SHA must equal the exact 40-character Git commit being served.
L99_DB_PATH=/data/l99.db
L99_RELEASE_SHA=

# Legacy compatibility only. Production ignores API_KEY unless this escape hatch
# is explicitly set to true. Legacy keys are not classified as human authority;
# leave both values disabled for new deployments.
API_KEY=
ALLOW_LEGACY_API_KEY=false

# Maximum JSON request body accepted by the main API router.
# Default: 10 MiB. The standalone manuscript audit should use its own bounded route.
API_MAX_BODY_BYTES=10485760

# Optional runtime scheduler controls.
RUNTIME_SCAN_INTERVAL_MS=300000
RUNTIME_DRAIN_INTERVAL_MS=15000
