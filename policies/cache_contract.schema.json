{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l99.local/schemas/cache_contract.schema.json",
  "title": "L99 Semantic Cache Entry Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "tenant_id",
    "producer_user_scope",
    "authorization_scope",
    "provenance_domain",
    "content_hash",
    "state_hash",
    "summary_hash",
    "revocation_epoch",
    "confidence",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "entry_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "producer_user_scope": { "type": "string", "minLength": 1 },
    "authorization_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance_domain": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 16 },
    "state_hash": { "type": "string", "minLength": 16 },
    "summary_hash": { "type": "string", "minLength": 16 },
    "revocation_epoch": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "embedding_model": { "type": "string" },
    "embedding_version": { "type": "string" },
    "partition_key": { "type": "string" },
    "shared_scope_policy": {
      "type": "string",
      "enum": ["private", "explicit_shared", "tenant_shared", "public_verified"]
    },
    "metadata": { "type": "object" }
  }
}