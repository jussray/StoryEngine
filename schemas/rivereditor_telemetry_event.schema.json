{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l99.local/schemas/rivereditor_telemetry_event.schema.json",
  "title": "RiverEditor L99 Telemetry Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "telemetry_id",
    "timestamp_utc",
    "tenant_id",
    "command_type",
    "chain_id",
    "stage",
    "status",
    "latency_ms"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "telemetry_id": { "type": "string", "minLength": 1 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "profile_tier": { "type": "string" },
    "cache_state": { "type": "string", "enum": ["hit", "miss", "disabled", "cold", "warm", "unknown"] },
    "command_type": { "type": "string", "minLength": 1 },
    "chain_id": { "type": "string", "minLength": 1 },
    "pipeline_name": { "type": "string" },
    "stage": { "type": "string", "minLength": 1 },
    "handler": { "type": "string" },
    "registry_schema_version": { "type": "string" },
    "runtime_version": { "type": "string" },
    "platform": { "type": "string", "enum": ["shell", "ui", "cli", "api", "unknown"] },
    "status": { "type": "string", "enum": ["started", "completed", "failed", "blocked", "rolled_back", "timed_out", "migrated"] },
    "latency_ms": { "type": "number", "minimum": 0 },
    "queue_wait_ms": { "type": "number", "minimum": 0 },
    "execution_ms": { "type": "number", "minimum": 0 },
    "rollback_applied": { "type": "boolean" },
    "validation_failed": { "type": "boolean" },
    "migration_applied": { "type": "boolean" },
    "unsupported_registry_blocked": { "type": "boolean" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "correlation_id": { "type": "string" },
    "metadata": { "type": "object" }
  }
}