{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l99.local/schemas/style_chain_telemetry.schema.json",
  "title": "RiverEditor Style Chain Telemetry Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "timestamp_utc",
    "tenant_id",
    "chain_id",
    "command_type",
    "handler",
    "stage",
    "latency_ms",
    "status",
    "registry_schema_version",
    "cache_state"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string" },
    "project_id": { "type": "string" },
    "chain_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string" },
    "command_type": { "type": "string", "minLength": 1 },
    "pipeline_name": { "type": "string" },
    "handler": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "agent": { "type": "string" },
    "latency_ms": { "type": "number", "minimum": 0 },
    "queue_wait_ms": { "type": "number", "minimum": 0 },
    "execution_ms": { "type": "number", "minimum": 0 },
    "status": { "type": "string", "enum": ["started", "completed", "failed", "blocked", "timed_out", "rolled_back"] },
    "profile_id": { "type": "string" },
    "profile_tier": { "type": "string" },
    "cache_state": { "type": "string", "enum": ["hot", "warm", "cold", "miss_only", "disabled", "unknown"] },
    "registry_schema_version": { "type": "string", "minLength": 1 },
    "migration_applied": { "type": "boolean" },
    "validation_failed": { "type": "boolean" },
    "unsupported_registry_blocked": { "type": "boolean" },
    "rollback_applied": { "type": "boolean" },
    "runtime_version": { "type": "string" },
    "platform": { "type": "string", "enum": ["shell", "ui", "cli", "api", "unknown"] },
    "metadata": { "type": "object" }
  }
}
