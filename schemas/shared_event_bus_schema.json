{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l99.local/schemas/shared_event_bus_schema.json",
  "title": "L99 Shared Event Bus Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "timestamp_utc",
    "tenant_id",
    "namespace",
    "severity",
    "status",
    "source_system",
    "reason"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "event_version": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "parent_event_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "revocation.triggered",
        "cache.partition_invalidated",
        "cache.semantic_hits_disabled",
        "cache.semantic_hits_restored",
        "rollback.started",
        "rollback.completed",
        "shadow.started",
        "shadow.passed",
        "shadow.failed",
        "promotion.blocked",
        "promotion.unblocked",
        "poisoning.suspected",
        "containment.started",
        "containment.cleared",
        "threshold.changed",
        "threshold.rejected",
        "incident.created",
        "incident.updated",
        "incident.closed",
        "lindymode.state_drift_detected",
        "lindymode.summary_refresh_triggered",
        "lindymode.continuity_conflict",
        "lindymode.context_budget_breach",
        "lindymode.recovery_completed"
      ]
    },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["info", "watch", "sev1", "sev2", "sev3"] },
    "status": { "type": "string", "enum": ["observed", "active", "blocked", "running", "passed", "failed", "completed", "cleared"] },
    "source_system": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string" },
    "scope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "policy_version": { "type": "string" },
    "model_version": { "type": "string" },
    "threshold": { "type": "number" },
    "rollback_action": { "type": "string" },
    "invalidation_action": { "type": "string" },
    "promotion_action": { "type": "string" },
    "artifact_ref": { "type": "string" },
    "group_key": { "type": "string" },
    "partition_id": { "type": "string" },
    "revocation_epoch": { "type": "integer", "minimum": 0 },
    "chapter_id": { "type": "string" },
    "arc_stage": { "type": "string" },
    "pov": { "type": "string" },
    "continuity_entity": { "type": "string" },
    "drift_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary_window": { "type": "string" },
    "token_budget_state": { "type": "string" },
    "recovery_action": { "type": "string" },
    "metadata": { "type": "object" }
  }
}
