{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l99.local/schemas/rivereditor_command_registry.schema.json",
  "title": "RiverEditor Command Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commands"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "mode", "group", "description", "handler", "emits"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["action", "writing", "operator", "agent", "query"] },
          "group": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "handler": { "type": "string", "minLength": 1 },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "pipeline": {
            "type": "array",
            "items": { "type": "string" }
          },
          "emits": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requires_confirmation": { "type": "boolean" }
        }
      }
    }
  }
}